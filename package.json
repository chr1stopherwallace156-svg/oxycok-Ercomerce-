{
  "name": "oxycok-commerce",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-driven AI-native commerce platform built on Shopify.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
